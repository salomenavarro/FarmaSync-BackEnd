generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Role {
  id    Int    @id @default(autoincrement())
  name  String @unique @map("nombre")
  users User[]

  @@map("roles")
}

model User {
  id                  Int       @id @default(autoincrement())
  nombreCompleto      String    @map("nombre_completo")
  numeroDocumento     String    @unique @map("numero_documento")
  correo              String    @unique
  telefono            String?
  passwordHash        String    @map("password_hash")
  roleId              Int       @map("role_id")
  role                Role      @relation(fields: [roleId], references: [id])

  sedeId              Int?      @map("sede_id")
  sede                Sede?     @relation(fields: [sedeId], references: [id])

  reservasAlistadas   Reserva[]            @relation("AlistadoPor")
  reservasEntregadas  Reserva[]            @relation("EntregadoPor")

  failedLoginAttempts Int       @default(0) @map("intentos_fallidos")
  lockedUntil         DateTime? @map("bloqueado_hasta")

  activo              Boolean   @default(true)
  createdAt           DateTime  @default(now()) @map("creado_en")
  updatedAt           DateTime  @updatedAt @map("actualizado_en")

  passwordResetTokens PasswordResetToken[]
  sessions            UserSession[]
  dependientes        Dependiente[]
  alertasStock        AlertaStock[]
  reservas            Reserva[]
  notificaciones      Notificacion[]
  @@map("users")
}

model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime @map("expira_en")
  used      Boolean  @default(false) @map("usado")
  createdAt DateTime @default(now()) @map("creado_en")

  @@map("password_reset_tokens")
}

model UserSession {
  id              Int      @id @default(autoincrement())
  userId          Int      @map("user_id")
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash       String   @unique @map("token_hash")
  ipAddress       String?  @map("ip_address")
  userAgent       String?  @map("user_agent")
  ultimaActividad DateTime @default(now()) @map("ultima_actividad")
  expiresAt       DateTime @map("expira_en")
  createdAt       DateTime @default(now()) @map("creado_en")

  @@map("user_sessions")
}

// ==========================================
// MODULO 1: SEDES Y PLAN FAMILIAR (DEPENDIENTES)
// ==========================================

model Sede {
  id           Int              @id @default(autoincrement())
  nombre       String
  ciudad       String
  zona         String
  direccion    String
  latitud      Float?
  longitud     Float?
  activa       Boolean          @default(true)
  createdAt    DateTime         @default(now()) @map("creado_en")
  updatedAt    DateTime         @updatedAt @map("actualizado_en")

  empleados    User[]
  inventarios  InventarioSede[]
  reservas     Reserva[]
  alertasStock AlertaStock[]

  @@map("sedes")
}

model Dependiente {
  id                Int       @id @default(autoincrement())
  titularId         Int       @map("titular_id")
  titular           User      @relation(fields: [titularId], references: [id], onDelete: Cascade)
  nombres           String
  apellidos         String
  tipoDocumento     String    @map("tipo_documento") // RC, TI, CC
  numeroDocumento   String    @unique @map("numero_documento")
  parentesco        String
  fechaNacimiento   DateTime  @map("fecha_nacimiento")
  correoElectronico String?   @map("correo_electronico")
  activo            Boolean   @default(true)
  createdAt         DateTime  @default(now()) @map("creado_en")
  updatedAt         DateTime  @updatedAt @map("actualizado_en")

  reservas          Reserva[]

  @@map("dependientes")
}

// ==========================================
// MODULO 2: CATALOGO, INVENTARIO Y ALERTAS
// ==========================================

model Medicamento {
  id             Int              @id @default(autoincrement())
  codigo         String           @unique
  nombreGenerico String           @map("nombre_generico")
  presentacion   String
  concentracion  String?
  requiereOrden  Boolean          @default(false) @map("requiere_orden")
  createdAt      DateTime         @default(now()) @map("creado_en")
  updatedAt      DateTime         @updatedAt @map("actualizado_en")

  codigoEan      String?          @unique @map("codigo_ean")

  inventarios    InventarioSede[]
  alertas        AlertaStock[]
  reservas       Reserva[]

  @@map("medicamentos")
}

model InventarioSede {
  id            Int         @id @default(autoincrement())
  sedeId        Int         @map("sede_id")
  sede          Sede        @relation(fields: [sedeId], references: [id], onDelete: Cascade)
  medicamentoId Int         @map("medicamento_id")
  medicamento   Medicamento @relation(fields: [medicamentoId], references: [id], onDelete: Cascade)
  cantidad      Int         @default(0)
  updatedAt     DateTime    @updatedAt @map("actualizado_en")

  @@unique([sedeId, medicamentoId])
  @@map("inventario_sedes")
}

model AlertaStock {
  id            Int         @id @default(autoincrement())
  userId        Int         @map("user_id")
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  medicamentoId Int         @map("medicamento_id")
  medicamento   Medicamento @relation(fields: [medicamentoId], references: [id], onDelete: Cascade)
  sedeId        Int?        @map("sede_id")
  sede          Sede?       @relation(fields: [sedeId], references: [id], onDelete: Cascade)
  notificado    Boolean     @default(false)
  createdAt     DateTime    @default(now()) @map("creado_en")

  @@unique([userId, medicamentoId, sedeId, notificado])
  @@map("alertas_stock")
}

// ==========================================
// MODULO 3: RESERVAS, PRORROGAS Y EXPIRACION
// ==========================================

enum EstadoReserva {
  PENDIENTE
  LISTA_PARA_RETIRO
  ENTREGADA
  CANCELADA_USUARIO
  RECHAZADA_FARMACIA
  EXPIRADA
}

model Reserva {
  id                 Int           @id @default(autoincrement())
  codigoReserva      String        @unique @map("codigo_reserva")
  codigoQr           String        @map("codigo_qr")
  userId             Int           @map("user_id")
  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  dependienteId      Int?          @map("dependiente_id")
  dependiente        Dependiente?  @relation(fields: [dependienteId], references: [id], onDelete: SetNull)
  sedeId             Int           @map("sede_id")
  sede               Sede          @relation(fields: [sedeId], references: [id], onDelete: Cascade)
  medicamentoId      Int           @map("medicamento_id")
  medicamento        Medicamento   @relation(fields: [medicamentoId], references: [id], onDelete: Cascade)
  numeroOrdenMedica  String        @map("numero_orden_medica")
  fechaRecogida      DateTime      @map("fecha_recogida")
  fechaLimite        DateTime      @map("fecha_limite")
  prorrogaSolicitada Boolean       @default(false) @map("prorroga_solicitada")
  estado             EstadoReserva @default(PENDIENTE)
  createdAt          DateTime      @default(now()) @map("creado_en")
  updatedAt          DateTime      @updatedAt @map("actualizado_en")

  metodoAlistamiento String?       @map("metodo_alistamiento") // "POS" | "MANUAL"
  alistadoAt         DateTime?     @map("alistado_en")
  alistadoPorId      Int?          @map("alistado_por_id")
  alistadoPor        User?         @relation("AlistadoPor", fields: [alistadoPorId], references: [id], onDelete: SetNull)
  entregadoAt        DateTime?     @map("entregado_en")
  entregadoPorId     Int?          @map("entregado_por_id")
  entregadoPor       User?         @relation("EntregadoPor", fields: [entregadoPorId], references: [id], onDelete: SetNull)
  motivoRechazo      String?       @map("motivo_rechazo")

  recordatorio24hEnviado Boolean       @default(false) @map("recordatorio_24h_enviado")
  recordatorio2hEnviado  Boolean       @default(false) @map("recordatorio_2h_enviado")
  alertaRetrasoEnviada   Boolean       @default(false) @map("alerta_retraso_enviada")

  @@map("reservas")
}
// ==========================================
// MODULO 5: NOTIFICACIONES E INCIDENCIAS
// ==========================================

enum TipoNotificacion {
  CONFIRMACION_RESERVA
  MEDICAMENTO_LISTO
  VENCIMIENTO_24H
  VENCIMIENTO_2H
  PRORROGA
  EXPIRACION
  REABASTECIMIENTO
  RETRASO_ALISTAMIENTO
  INCONSISTENCIA_LOTE
  CANCELACION_FARMACIA
}

enum CategoriaNotificacion {
  RESERVA
  MEDICAMENTO
  INCIDENCIA
}

enum PrioridadNotificacion {
  INFORMATIVA
  IMPORTANTE
  URGENTE
}

model Notificacion {
  id                Int                   @id @default(autoincrement())
  userId            Int                   @map("user_id")
  user              User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  tipo              TipoNotificacion
  categoria         CategoriaNotificacion
  prioridad         PrioridadNotificacion
  titulo            String
  mensaje           String
  leida             Boolean               @default(false)
  fechaLectura      DateTime?             @map("fecha_lectura")

  reservaId         Int?                  @map("reserva_id")
  codigoReserva     String?               @map("codigo_reserva")
  medicamentoId     Int?                  @map("medicamento_id")
  medicamentoNombre String?               @map("medicamento_nombre")
  medicamentoCodigo String?               @map("medicamento_codigo")
  sedeId            Int?                  @map("sede_id")
  sedeNombre        String?               @map("sede_nombre")
  fechaVencimiento  DateTime?             @map("fecha_vencimiento")

  createdAt         DateTime              @default(now()) @map("creado_en")

  @@index([userId, leida])
  @@map("notificaciones")
}
